$/q = ""
$/orders = [{id: "#1041", customer: "Ana Souza", total: "$84.00", status: "Paid"}, {id: "#1042", customer: "Oluwaseun Adebayo-Whitfield Consulting Partners", total: "$1,920.00", status: "Pending"}, {id: "#1043", customer: "Kenji Mori", total: "$36.50", status: "Paid"}, {id: "#1044", customer: "Priya Nair", total: "$210.00", status: "Refunded"}, {id: "#1045", customer: "Tom Becker", total: "$58.00", status: "Paid"}, {id: "#1046", customer: "Lina Haddad", total: "$142.75", status: "Pending"}, {id: "#1047", customer: "Marco Rossi", total: "$19.99", status: "Paid"}, {id: "#1048", customer: "Chloe Martin", total: "$305.00", status: "Paid"}]
root = Column([title, search, orders, pager])
title = Text("Orders", "h1")
search = TextField("Search orders", $/q)
orders = Table([{key: "id", label: "Order"}, {key: "customer", label: "Customer"}, {key: "total", label: "Total"}, {key: "status", label: "Status", as: "Badge"}], $/orders)
pager = Row([prev, page, next], "end", "center")
prev = Button(prev_t, _, Event("prev"))
prev_t = Text("Previous")
page = Text("Page 1 of 4")
next = Button(next_t, _, Event("next"))
next_t = Text("Next")

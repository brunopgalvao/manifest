<body id="table">
<script type="application/json">{"q": "", "orders": [{"id": "#1041", "customer": "Ana Souza", "total": "$84.00", "status": "Paid"}, {"id": "#1042", "customer": "Oluwaseun Adebayo-Whitfield Consulting Partners", "total": "$1,920.00", "status": "Pending"}, {"id": "#1043", "customer": "Kenji Mori", "total": "$36.50", "status": "Paid"}, {"id": "#1044", "customer": "Priya Nair", "total": "$210.00", "status": "Refunded"}, {"id": "#1045", "customer": "Tom Becker", "total": "$58.00", "status": "Paid"}, {"id": "#1046", "customer": "Lina Haddad", "total": "$142.75", "status": "Pending"}, {"id": "#1047", "customer": "Marco Rossi", "total": "$19.99", "status": "Paid"}, {"id": "#1048", "customer": "Chloe Martin", "total": "$305.00", "status": "Paid"}]}</script>
<ui-column>
  <ui-text text="Orders" variant="h1" />
  <ui-text-field label="Search orders" value="{$/q}" />
  <ui-table rows="{$/orders}">
    <script type="application/json" slot="columns">[{"key": "id", "label": "Order"}, {"key": "customer", "label": "Customer"}, {"key": "total", "label": "Total"}, {"key": "status", "label": "Status", "as": "Badge"}]</script>
  </ui-table>
  <ui-row justify="end" align="center">
    <ui-button onclick="{Event('prev')}"><ui-text text="Previous" /></ui-button>
    <ui-text text="Page 1 of 4" />
    <ui-button onclick="{Event('next')}"><ui-text text="Next" /></ui-button>
  </ui-row>
</ui-column>
</body>

root = Column([title, diagram])
title = Text("How Manifest works", "h1")
diagram = Canvas(688, 220, "Pipeline: Agent writes MX, Renderer draws it, Perception reads back to Agent", [agent, mx, renderer, perception, a1, a2, a3, a4])
agent = Box(0, 40, 130, 56, "Agent", "accent")
mx = Box(186, 40, 130, 56, "MX", "accent")
renderer = Box(372, 40, 130, 56, "Renderer", "accent")
perception = Box(558, 40, 130, 56, "Perception", "positive")
a1 = Arrow("agent", "mx", "writes")
a2 = Arrow("mx", "renderer", "draws")
a3 = Arrow("renderer", "perception", "reads")
a4 = Arrow("perception", "agent", "tree, boxes, diagnostics", "below", true)

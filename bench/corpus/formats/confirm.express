root = Card(col)
col = Column([title, body, acts])
title = Text("Delete 3 files?", "h2")
body = Text("report.pdf, notes.md and draft.docx will be moved to Trash.")
acts = Row([cancel, delete], "end")
cancel = Button(cancel_t, _, Event("cancel"))
cancel_t = Text("Cancel")
delete = Button(delete_t, "primary", Event("delete"))
delete_t = Text("Delete")

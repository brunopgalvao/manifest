[
 {
  "version": "v1.0",
  "createSurface": {
   "surfaceId": "settings",
   "catalogId": "https://manifest.dev/bench/catalog.json",
   "components": [
    {
     "id": "comp_2",
     "component": "Text",
     "text": "Settings",
     "variant": "h1"
    },
    {
     "id": "comp_3",
     "component": "Tabs",
     "tabs": [
      {
       "title": "General",
       "child": "general"
      },
      {
       "title": "Notifications",
       "child": "notif"
      }
     ]
    },
    {
     "id": "comp_4",
     "component": "CheckBox",
     "label": "Dark mode",
     "value": {
      "@path": "/dark"
     }
    },
    {
     "id": "general",
     "component": "Column",
     "children": [
      "comp_4"
     ]
    },
    {
     "id": "comp_5",
     "component": "CheckBox",
     "label": "Push notifications",
     "value": {
      "@path": "/push"
     }
    },
    {
     "id": "comp_6",
     "component": "CheckBox",
     "label": "Email digest",
     "value": {
      "@path": "/email"
     }
    },
    {
     "id": "comp_7",
     "component": "CheckBox",
     "label": "Sounds",
     "value": {
      "@path": "/sound"
     }
    },
    {
     "id": "comp_8",
     "component": "Slider",
     "label": "Volume",
     "min": 0,
     "max": 100,
     "value": {
      "@path": "/volume"
     }
    },
    {
     "id": "notif",
     "component": "Column",
     "children": [
      "comp_5",
      "comp_6",
      "comp_7",
      "comp_8"
     ]
    },
    {
     "id": "comp_1",
     "component": "Column",
     "children": [
      "comp_2",
      "comp_3",
      "general",
      "notif"
     ]
    }
   ],
   "dataModel": {
    "dark": false,
    "push": true,
    "email": false,
    "sound": true,
    "volume": 70
   }
  }
 }
]
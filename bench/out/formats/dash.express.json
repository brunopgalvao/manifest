[
 {
  "version": "v1.0",
  "createSurface": {
   "surfaceId": "dash",
   "catalogId": "https://manifest.dev/bench/catalog.json",
   "components": [
    {
     "id": "root",
     "component": "Column",
     "children": [
      "title",
      "kpis",
      "chart",
      "controls"
     ]
    },
    {
     "id": "title",
     "component": "Text",
     "text": "Revenue overview",
     "variant": "h1"
    },
    {
     "id": "kpis",
     "component": "Row",
     "children": [
      "rev",
      "orders",
      "churn"
     ]
    },
    {
     "id": "rev",
     "component": "Metric",
     "label": "Revenue",
     "value": "$308k",
     "delta": "+14%",
     "tone": "positive"
    },
    {
     "id": "orders",
     "component": "Metric",
     "label": "Orders",
     "value": "1,284",
     "delta": "+6%",
     "tone": "positive"
    },
    {
     "id": "churn",
     "component": "Metric",
     "label": "Churn",
     "value": "2.1%",
     "delta": "+0.4pt",
     "tone": "negative"
    },
    {
     "id": "chart",
     "component": "BarChart",
     "description": "Monthly revenue (k$)",
     "labels": [
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep"
     ],
     "values": [
      38,
      42,
      51,
      47,
      57,
      73
     ],
     "highlight": 5
    },
    {
     "id": "controls",
     "component": "Row",
     "children": [
      "range",
      "export"
     ],
     "align": "center"
    },
    {
     "id": "range",
     "component": "ChoicePicker",
     "label": "Range",
     "options": [
      {
       "label": "Q3",
       "value": "Q3"
      },
      {
       "label": "YTD",
       "value": "YTD"
      },
      {
       "label": "12m",
       "value": "12m"
      }
     ],
     "value": {
      "@path": "/range"
     }
    },
    {
     "id": "export",
     "component": "Button",
     "child": "export_t",
     "action": {
      "event": {
       "name": "export"
      }
     },
     "checks": [
      {
       "condition": {
        "@call": "required",
        "args": {
         "value": {
          "@path": "/exportReady"
         }
        }
       },
       "message": "No data to export"
      }
     ]
    },
    {
     "id": "export_t",
     "component": "Text",
     "text": "Export CSV"
    }
   ],
   "dataModel": {
    "range": [
     "YTD"
    ]
   }
  }
 }
]
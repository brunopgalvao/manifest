      card @300,1997,207,428
        link "Copy code" /docs/classless @317,2012,173,20
        text /* Custom Class-less version for React */ @use "pico" with ( // Define the root element used to target <header>, <main>, <footer> // with $enable-semantic-container and $enable-responsive-spacings $semantic-root-element: "#root", // Enable <header>, <main>, <footer> inside $semantic-root-element as containers $enable-semantic-container: true, // Enable .classes $enable-classes: false ) @317,2044,173,366
      text The code above will compile Pico with the containers defined like this: @300,2437,207,61

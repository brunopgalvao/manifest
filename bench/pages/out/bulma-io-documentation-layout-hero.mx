    $hero-body-padding-smallCopy | var(--bulma-hero-body-padding-small)Copy | 1.5remCopy
    $hero-body-padding-mediumCopy | var(--bulma-hero-body-padding-medium)Copy | 9rem 4.5remCopy
    $hero-body-padding-largeCopy | var(--bulma-hero-body-padding-large)Copy | 18rem 6remCopy
    $hero-gradient-h-offsetCopy | var(--bulma-hero-gradient-h-offset)Copy | 5degCopy
    $hero-gradient-s-offsetCopy | var(--bulma-hero-gradient-s-offset)Copy | 10%Copy
    $hero-gradient-l-offsetCopy | var(--bulma-hero-gradient-l-offset:)Copy | 5%Copy

        $control-radius-smallCopy | var(--bulma-control-radius-small)Copy | var(--bulma-radius-small)Copy
        $control-border-widthCopy | var(--bulma-control-border-width)Copy | 1pxCopy
        $control-sizeCopy | var(--bulma-control-size)Copy | var(--bulma-size-normal)Copy
        $control-heightCopy | var(--bulma-control-height)Copy | 2.5emCopy
        $control-line-heightCopy | var(--bulma-control-line-height)Copy | 1.5Copy
        $control-padding-verticalCopy | var(--bulma-control-padding-vertical)Copy | calc(0.5em - 1px)Copy
        $control-padding-horizontalCopy | var(--bulma-control-padding-horizontal)Copy | calc(0.75em - 1px)Copy
        $control-focus-shadow-lCopy | var(--bulma-control-focus-shadow-l)Copy | 50%Copy
        $label-colorCopy | var(--bulma-label-color)Copy | var(--bulma-text-strong)Copy
        $label-weightCopy | var(--bulma-label-weight)Copy | var(--bulma-weight-semibold)Copy
        $help-sizeCopy | var(--bulma-help-size)Copy | var(--bulma-size-small)Copy

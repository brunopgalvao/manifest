        button Inverted primary
        button Inverted primary
      col
        text "<button class=\"button is-link is-inverted\">Inverted</button> <button class=\"button is-primary is-inverted\">Inverted</button> <button class=\"button is-info is-inverted\">Inverted</button> <button class=\"button is-success is-inverted\">Inverted</button> <button class=\"button is-danger is-inverted\">Inverted</button>"

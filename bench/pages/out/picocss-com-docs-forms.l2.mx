      text <form> <!-- Input inside label --> <label> First name <input name="first_name" placeholder="First name" autocomplete="given-name" /> </label> <!-- Input outside label --> <label for="email">Email</label> <input type="email" id="email" placeholder="Email" autocomplete="email" /> </form> @271,842,214,244

  text ,
  text "\"/d-1.mjs\"" warning
  text :
  text "\"sha384-MBO5IDfYaE6c6Aao94oZrIOiC6CGiSN2n4QUbHNPhzk5Xhm0djZLQqTpL0HzTUxk\"" warning
  text }
  text }

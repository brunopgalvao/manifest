  text }
  text }
text "The same is true for rules that impact already resolved modules defined in specific scopes. If we already resolved \"/app/helper\" from \"/app/main.mjs\" the following new import map:"
card
  text {
  text "\"scopes\"" warning
  text :
  text {
  text "\"/app/\"" warning
  text :
  text {
  text "\"/app/helper\"" warning
  text :
  text "\"./helper/index.mjs\"" warning
  text }
  text },
  text "\"imports\"" warning
  text :
  text {
  text "\"lodash\"" warning
  text :
  text "\"/node_modules/lodash-es/lodash.js\"" warning
  text }
  text }
text Would similarly be equivalent to:
card
  text {
  text "\"imports\"" warning
  text :
  text {
  text "\"lodash\"" warning
  text :
  text "\"/node_modules/lodash-es/lodash.js\"" warning
  text }
  text }
text We could also have cases where a single already-resolved module specifier has multiple rules for its resolution, depending on the referring script. In such cases, only the relevant rules would not be added to the map.
text "For example, if we already resolved \"/app/helper\" from \"/app/vendor/main.mjs\", the following new import map:"
card
  text {
  text "\"scopes\"" warning
  text :
  text {
  text "\"/app/\"" warning
  text :
  text {
  text "\"/app/helper\"" warning
  text :
  text "\"./helper/index.mjs\"" warning
  text },
  text "\"/app/vendor/\"" warning
  text :
  text {
  text "\"/app/\"" warning
  text :
  text "\"./vendor_helper/\"" warning
  text },
  text "\"/vendor/\"" warning
  text :
  text {
  text "\"/app/helper\"" warning
  text :
  text "\"./helper/vendor_index.mjs\"" warning
  text }
  text },
  text "\"imports\"" warning
  text :
  text {
  text "\"lodash\"" warning
  text :
  text "\"/node_modules/lodash-es/lodash.js\"" warning
  text "\"/app/\"" warning
  text :
  text "\"./general_app_path/\"" warning
  text "\"/app/helper\"" warning
  text :
  text "\"./other_path/helper/index.mjs\"" warning
  text }
  text }
text Would be equivalent to:
card
  text {
  text "\"scopes\"" warning
  text :
  text {
  text "\"/vendor/\"" warning
  text :
  text {
  text "\"/app/helper\"" warning
  text :
  text "\"./helper/vendor_index.mjs\"" warning

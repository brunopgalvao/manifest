  text span success
  text itemscope primary
  text ><
  text meta success
  text itemprop primary
  text =
  text "\"name\"" warning
  text content primary
  text =
  text "\"The Castle\"" warning
  text ></
  text span success
  text >
  text <
  text figure success
  text >
  text <
  text img success
  text src primary
  text =
  text "\"castle.jpeg\"" warning
  text >

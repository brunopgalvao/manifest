      row
        field Login
        field Password password
        button "Log in" primary
      link "Privacy Policy" /docs/version-picker
      toggle "I agree to the" on
      link "Copy code" /docs/version-picker
      text "<link rel=\"stylesheet\" href=\"css/pico.min.css\">"
      h2 Configuration#
      select configuration *"Regular, with classes" "Class-less, with centered viewports" "Class-less, with fluid viewport"
      text The default version of Pico CSS, with all components and classes.
      toggle "Conditional Styling" off
      text The default version applies Pico styles to every HTML element.
      h2 Usage from CDN#
      card
        link "Copy code" /docs/version-picker
        text "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css\" >"
      h2 Usage with Sass#
      card
        link "Copy code" /docs/version-picker
        text "@use \"pico\";"
      h2 Starter HTML template#
      card
        link "Copy code" /docs/version-picker
        text "<!doctype html> <html lang=\"en\"> <head> <meta charset=\"utf-8\"> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> <meta name=\"color-scheme\" content=\"light dark\"> <link rel=\"stylesheet\" href=\"css/pico.min.css\"> <title>Hello world!</title> </head> <body> <main class=\"container\"> <h1>Hello world!</h1> </main> </body> </html>"
      link "Edit this page on GitHub" https://github.com/picocss/picocss.com/blob/main/app/routes/docs.version-picker.jsx

    text The pagination component consists of several elements: @53,420,658,20
    text pagination-previous and pagination-next for incremental navigation @53,452,658,20
    text which displays page items: @53,484,658,21
    text pagination-list danger @53,517,658,20
    text pagination-link for the page numbers @53,549,658,20
    text pagination-ellipsis for range separators @53,581,658,21
    text All elements are optional so you can compose your pagination as you wish. @53,614,658,20
    text Example @53,646,658,20
    row @53,678,658,20
      link Previous # @53,678,58,20
      link "Next page" # @123,678,69,20
      row @204,678,467,20
        link "Goto page 1" # @204,678,79,20
        text … @295,678,13,20
        link "Goto page 45" # @320,678,91,20
        text 46 @423,678,18,20
        link "Goto page 47" # @453,678,90,20
        text … @555,678,13,20
        link "Goto page 86" # @580,678,91,20

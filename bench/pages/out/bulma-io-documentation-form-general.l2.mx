    text This is a help text @36,2493,675,21
    text HTML @36,2526,675,20
    text <div class="field"> <label class="label">Label</label> <div class="control"> <input class="input" type="text" placeholder="Text input"> </div> <p class="help">This is a help text</p> </div> @36,2558,675,40
    button Copy danger @36,2610,675,37
    text This container allows form fields to be spaced consistently. @36,2659,675,20
    text Example @36,2691,675,20
    text Name @36,2723,675,21
    field "e.g Alex Smith" @36,2756,675,57
